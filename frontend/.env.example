# Browser API base path; keep /api when served through nginx.
VITE_API_BASE_URL=/api
VITE_FRONTEND_PORT=8000
VITE_DEFAULT_DUE_DAYS=14
VITE_OVERDUE_CARD_COLOR=#FFF0F0
# Must match backend TOKEN; this value is embedded in the browser bundle, not secret storage.
VITE_TOKEN=change-me
VITE_CARD_PREFIX=CARD-
CREATED_CARD_COLOR=#BDBF4F
BACKLOG_CARD_COLOR=#5F76FC
ARCHIVED_CARD_COLOR=#000000

# Auth contract: frontend sends VITE_TOKEN as x-access-token to the API.
# nginx additionally protects the external perimeter with Basic Auth.
# Legacy risk: if backend TOKEN is unset, its middleware currently permits requests (fail-open).
# Do not put real credentials in this example file; use the local ignored .env instead.
