# SQLite database URL used by the backend.
DATABASE_URL="file:./kanban.db"
# Comma-separated browser origins allowed by Nest CORS.
CORS_ORIGIN="http://localhost:8000,http://localhost:5173"
# Must match frontend VITE_TOKEN; backend reads x-access-token.
# Replace this example locally; never commit real credentials.
TOKEN="my-desk-example"

# Auth contract: nginx applies Basic Auth at the external perimeter and the API
# checks x-access-token against TOKEN. If TOKEN is unset, current middleware is
# permissive (fail-open), a documented legacy risk retained for compatibility.